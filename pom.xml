<?xml version="1.0" encoding="UTF-8"?>
<project xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xmlns="http://maven.apache.org/POM/4.0.0"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.5.7</version>
        <relativePath/>
    </parent>

    <groupId>dev.xuya</groupId>
    <artifactId>xuya-plus</artifactId>
    <version>1.0.0</version>
    <packaging>pom</packaging>

    <name>XuYa Plus</name>
    <description>RuoYi-Vue-Plus 同款后台管理脚手架，基于 Quick-Dev（注解式 CRUD + Sa-Token + Redis）</description>
    <url>https://github.com/xuya-dev</url>

    <modules>
        <module>xuya-common</module>
        <module>xuya-modules/xuya-system</module>
        <module>xuya-admin</module>
    </modules>

    <properties>
        <java.version>17</java.version>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <quick-dev.version>0.3.0</quick-dev.version>
        <hutool.version>5.8.38</hutool.version>
        <springdoc.version>2.8.17</springdoc.version>
    </properties>

    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>dev.xuya</groupId>
                <artifactId>quick-dev-spring-boot-starter</artifactId>
                <version>${quick-dev.version}</version>
            </dependency>
            <dependency>
                <groupId>dev.xuya</groupId>
                <artifactId>quick-dev-redis-spring-boot-starter</artifactId>
                <version>${quick-dev.version}</version>
            </dependency>
            <dependency>
                <groupId>org.springdoc</groupId>
                <artifactId>springdoc-openapi-starter-webmvc-ui</artifactId>
                <version>${springdoc.version}</version>
            </dependency>
            <dependency>
                <groupId>cn.hutool</groupId>
                <artifactId>hutool-all</artifactId>
                <version>${hutool.version}</version>
            </dependency>
            <dependency>
                <groupId>dev.xuya</groupId>
                <artifactId>xuya-common</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>dev.xuya</groupId>
                <artifactId>xuya-system</artifactId>
                <version>${project.version}</version>
            </dependency>
        </dependencies>
    </dependencyManagement>
</project>
