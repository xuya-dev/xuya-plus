<?xml version="1.0" encoding="UTF-8"?>
<project xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xmlns="http://maven.apache.org/POM/4.0.0"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>dev.xuya</groupId>
        <artifactId>xuya-plus</artifactId>
        <version>1.1.0</version>
        <relativePath>../../pom.xml</relativePath>
    </parent>

    <artifactId>xuya-system</artifactId>
    <name>XuYa System</name>
    <description>系统模块：领域模型（domain）、Mapper、Service 与框架 SPI 实现（权限数据源/字典加载器/日志落地/数据权限）</description>

    <dependencies>
        <dependency>
            <groupId>dev.xuya</groupId>
            <artifactId>xuya-common-core</artifactId>
        </dependency>
        <dependency>
            <groupId>dev.xuya</groupId>
            <artifactId>xuya-common-oss</artifactId>
        </dependency>
        <dependency>
            <groupId>dev.xuya</groupId>
            <artifactId>xuya-common-redis</artifactId>
        </dependency>

        <!-- AWS S3 v2：兼容 MinIO / 阿里云 OSS / 腾讯云 COS 等 S3 协议存储 -->
        <dependency>
            <groupId>software.amazon.awssdk</groupId>
            <artifactId>s3</artifactId>
        </dependency>
        <!-- oshi：服务监控（OS/硬件信息） -->
        <dependency>
            <groupId>com.github.oshi</groupId>
            <artifactId>oshi-core</artifactId>
        </dependency>
        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <optional>true</optional>
        </dependency>
    </dependencies>
</project>
