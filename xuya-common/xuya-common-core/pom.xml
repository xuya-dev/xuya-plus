<?xml version="1.0" encoding="UTF-8"?>
<project xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xmlns="http://maven.apache.org/POM/4.0.0"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>dev.xuya</groupId>
        <artifactId>xuya-common</artifactId>
        <version>1.1.0</version>
    </parent>

    <artifactId>xuya-common-core</artifactId>
    <name>XuYa Common Core</name>
    <description>核心工具：常量、通用工具类、公共注解与序列化</description>

    <dependencies>
        <!-- 工具库（IpUtil 依赖 hutool 的 servlet 工具） -->
        <dependency>
            <groupId>cn.hutool</groupId>
            <artifactId>hutool-all</artifactId>
        </dependency>
        <dependency>
            <groupId>jakarta.servlet</groupId>
            <artifactId>jakarta.servlet-api</artifactId>
            <scope>provided</scope>
        </dependency>
        <!-- Jackson：公共序列化器（数据脱敏） -->
        <dependency>
            <groupId>com.fasterxml.jackson.core</groupId>
            <artifactId>jackson-databind</artifactId>
        </dependency>
    </dependencies>
</project>
